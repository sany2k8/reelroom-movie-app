# Copy to .env and fill in. .env is gitignored; this file is not.

NODE_ENV=development
PORT=3000

# --- Access -----------------------------------------------------------------
# Everyone entering the room needs this, including over an ngrok/cloudflared
# tunnel. Change it before you expose the app. The server refuses to start in
# production while this is still 1234.
SUNFLIX_PIN=1234

# Signs session cookies. Generate with: openssl rand -hex 32
# Required when NODE_ENV=production. Rotating it signs everyone out.
SESSION_SECRET=

# How long a sign-in lasts.
SESSION_DAYS=30

# --- Metadata ---------------------------------------------------------------
# Free, from https://www.themoviedb.org/settings/api
# EITHER credential on that page works — the v3 "API Key" (32 hex characters)
# or the v4 "API Read Access Token" (a long string starting with eyJ).
# Without one you still get titles, real durations and quality badges from the
# files themselves — but no ratings, cast, categories, backdrops or trailers.
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# --- Storage ----------------------------------------------------------------
# "local" reads MOVIES_DIR. "s3" reads a bucket, and works with AWS S3,
# Cloudflare R2, MinIO and Backblaze B2.
STORAGE_DRIVER=local

# Only needed when STORAGE_DRIVER=s3. Install the SDK first:
#   npm --prefix backend install @aws-sdk/client-s3 @aws-sdk/s3-request-presigner
S3_BUCKET=
S3_REGION=us-east-1
# Leave blank for AWS; set for R2/MinIO/B2 e.g. http://localhost:9000
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Folder inside the bucket, e.g. movies
S3_PREFIX=
# MinIO and some B2 setups need this
S3_FORCE_PATH_STYLE=false
# Redirect players to a presigned URL instead of proxying bytes through the app.
# Much cheaper, but the URL works for anyone holding it until it expires.
S3_SIGNED_URLS=false
S3_SIGNED_URL_TTL=21600

# --- Auto-import ------------------------------------------------------------
# New files appear without a restart.
WATCH_ENABLED=true
# How long a file's size must stop changing before it is imported. Raise this if
# you copy very large files over a slow network share.
WATCH_STABLE_SECONDS=8
# Object stores can't emit events, so they are polled at this interval.
WATCH_POLL_SECONDS=300

# --- Paths (relative to the project root) -----------------------------------
MOVIES_DIR=movies
POSTERS_DIR=posters
DATA_DIR=data

# --- Networking -------------------------------------------------------------
# Tunnels put an X-Forwarded-For in front of us; keep this true behind ngrok or
# cloudflared so rate limiting sees real client IPs.
TRUST_PROXY=true

# Optional: your public tunnel origin, e.g. https://sunflix.example.com
PUBLIC_ORIGIN=
