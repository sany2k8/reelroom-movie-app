{
  "name": "sunflix",
  "version": "2.0.0",
  "private": true,
  "description": "SunFlix — a private, production-shaped streaming app for your own movie files",
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "serve": "npm run build && npm start",
    "dev:api": "npm --prefix backend run dev",
    "dev:ui": "npm --prefix frontend run dev",
    "rescan": "npm --prefix backend run rescan",
    "typecheck": "npm --prefix frontend run typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
